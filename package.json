{
  "name": "zstdframes",
  "version": "0.1.3",
  "description": "Frame-level access to multi-frame zstd files (agent session logs, container logs) with Node built-in zlib: count, seek, stream one frame at a time.",
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "bin": {
    "zstdframes": "src/cli.js"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    }
  },
  "files": [
    "src",
    "README.md"
  ],
  "scripts": {
    "test": "node --test"
  },
  "keywords": [
    "zstd",
    "zstandard",
    "stream",
    "frame",
    "multiframe",
    "decompress",
    "jsonl",
    "log"
  ],
  "engines": {
    "node": ">=22.15"
  },
  "license": "MIT",
  "dependencies": {},
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ltl0312/zstdframes.git"
  },
  "homepage": "https://github.com/ltl0312/zstdframes#readme",
  "bugs": {
    "url": "https://github.com/ltl0312/zstdframes/issues"
  },
  "author": "ltl0312"
}
